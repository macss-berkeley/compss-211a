   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "tiny"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "eb184b94ad710152",
   "metadata": {
    "tags": []
   },
   "source": [
    "Show the number of rows and columns."
   ]
  },
  {
   "cell_type": "code",
